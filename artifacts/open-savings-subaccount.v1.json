{
  "schemaVersion": "1.0",

  "identity": {
    "id": "legacycore.open-savings-subaccount",
    "name": "Open Savings Sub-Account",
    "version": "1.0.0",
    "description": "Open a new savings sub-account for an existing LegacyCore member."
  },

  "compatibility": {
    "application": "LegacyCore",
    "surface": "web",
    "vendor": "demo"
  },

  "contract": {
    "inputs": {
      "memberId": {
        "type": "string",
        "required": true,
        "sensitive": true
      },
      "product": {
        "type": "enum",
        "required": true,
        "values": ["SAVINGS", "CHECKING"]
      },
      "openingDeposit": {
        "type": "decimal",
        "required": true,
        "minimum": 0
      }
    },

    "outputs": {
      "confirmationId": {
        "type": "string"
      }
    },

    "businessOutcomes": [
      {
        "code": "MEMBER_NOT_FOUND",
        "description": "The supplied member ID does not exist."
      },
      {
        "code": "ACCOUNT_RESTRICTED",
        "description": "The member exists but is not permitted to open a new sub-account."
      }
    ]
  },

  "steps": [
    {
      "id": "search.fill-member-id",
      "phase": "search_member",
      "action": {
        "type": "fill",
        "value": "{{memberId}}"
      },
      "target": {
        "strategies": [
          {
            "type": "label",
            "value": "Member Number"
          },
          {
            "type": "attribute",
            "name": "name",
            "value": "fld_104"
          }
        ]
      }
    },

    {
      "id": "search.submit",
      "phase": "search_member",
      "action": {
        "type": "click"
      },
      "target": {
        "strategies": [
          {
            "type": "role",
            "role": "button",
            "name": "FIND"
          },
          {
            "type": "text",
            "value": "FIND"
          }
        ]
      },
      "postconditions": [
        {
          "type": "one_of",
          "conditions": [
            {
              "type": "text_visible",
              "value": "ACCOUNT MAINTENANCE"
            },
            {
              "type": "business_outcome",
              "code": "MEMBER_NOT_FOUND",
              "whenTextVisible": "RECORD NOT FOUND"
            }
          ]
        }
      ]
    },

    {
      "id": "account.open-new-subaccount",
      "phase": "open_subaccount",
      "action": {
        "type": "click"
      },
      "target": {
        "strategies": [
          {
            "type": "role",
            "role": "button",
            "name": "OPEN NEW SUB-ACCOUNT"
          },
          {
            "type": "text",
            "value": "OPEN NEW SUB-ACCOUNT"
          }
        ]
      },
      "postconditions": [
        {
          "type": "text_visible",
          "value": "OPEN SUB-ACCOUNT"
        }
      ]
    },

    {
      "id": "account.select-product",
      "phase": "configure_account",
      "action": {
        "type": "select",
        "value": "{{product}}"
      },
      "target": {
        "strategies": [
          {
            "type": "label",
            "value": "Product"
          },
          {
            "type": "attribute",
            "name": "name",
            "value": "fld_22"
          }
        ]
      }
    },

    {
      "id": "account.fill-opening-deposit",
      "phase": "configure_account",
      "action": {
        "type": "fill",
        "value": "{{openingDeposit}}"
      },
      "target": {
        "strategies": [
          {
            "type": "label",
            "value": "Opening Deposit"
          },
          {
            "type": "attribute",
            "name": "name",
            "value": "fld_23"
          }
        ]
      }
    },

    {
      "id": "account.continue",
      "phase": "configure_account",
      "action": {
        "type": "click"
      },
      "target": {
        "strategies": [
          {
            "type": "role",
            "role": "button",
            "name": "CONTINUE"
          },
          {
            "type": "text",
            "value": "CONTINUE"
          }
        ]
      },
      "postconditions": [
        {
          "type": "text_visible",
          "value": "REVIEW NEW ACCOUNT"
        }
      ]
    },

    {
      "id": "review.verify-member",
      "phase": "review",
      "action": {
        "type": "assert_text",
        "expected": "{{memberId}}"
      },
      "target": {
        "strategies": [
          {
            "type": "near_text",
            "value": "Member"
          }
        ]
      }
    },

    {
      "id": "review.verify-product",
      "phase": "review",
      "action": {
        "type": "assert_text",
        "expected": "{{product}}"
      },
      "target": {
        "strategies": [
          {
            "type": "near_text",
            "value": "Product"
          }
        ]
      }
    },

    {
      "id": "review.confirm-open",
      "phase": "confirm",
      "risk": "irreversible",
      "action": {
        "type": "click"
      },
      "target": {
        "strategies": [
          {
            "type": "role",
            "role": "button",
            "name": "CONFIRM OPEN"
          },
          {
            "type": "text",
            "value": "CONFIRM OPEN"
          }
        ]
      },
      "postconditions": [
        {
          "type": "text_visible",
          "value": "ACCOUNT OPENED"
        },
        {
          "type": "text_visible",
          "value": "TRANSACTION COMPLETE"
        }
      ]
    }
  ],

  "outputs": [
    {
      "name": "confirmationId",
      "extract": {
        "type": "text",
        "target": {
          "strategies": [
            {
              "type": "near_text",
              "value": "Confirmation"
            },
            {
              "type": "attribute",
              "name": "id",
              "value": "confirmation_value"
            }
          ]
        }
      }
    }
  ],

  "successCheckpoint": {
    "all": [
      {
        "type": "text_visible",
        "value": "ACCOUNT OPENED"
      },
      {
        "type": "text_visible",
        "value": "TRANSACTION COMPLETE"
      },
      {
        "type": "text_matches_input",
        "label": "Member",
        "input": "memberId"
      }
    ]
  }
}